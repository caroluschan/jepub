{
  "name": "jepub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run prepare:assets",
    "prebuild": "npm run prepare:assets",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/clean-ort-assets.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run typecheck && npm run test",
    "verify:full": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@lingo-reader/mobi-parser": "^0.4.6",
    "dompurify": "3.4.17",
    "idb": "8.0.4",
    "jszip": "3.10.2",
    "kuromoji": "0.1.2",
    "kuroshiro": "1.2.1",
    "kuroshiro-analyzer-kuromoji": "1.1.0",
    "path-browserify": "1.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "3.2.7",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
